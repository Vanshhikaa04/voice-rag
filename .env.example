# Model providers. Set at least one for generated answers and agents.
# With neither, NEXUS still indexes and answers by quoting your documents.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1     # any OpenAI-compatible endpoint
ANTHROPIC_API_KEY=
VOICERAG_MODEL=claude-haiku-5-5

# Speech. Sarvam is preferred for Hindi; OpenAI is used if it is the only key.
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# NEXUS_VOICE_PROVIDER=sarvam                   # sarvam | elevenlabs | openai | local

# Required in production. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# NEXUS_ENV=production
# NEXUS_SECRET_KEY=
# NEXUS_COOKIE_SECURE=true
# NEXUS_ALLOW_SIGNUP=false

# Google Drive and Gmail: create an OAuth client in Google Cloud Console and add the redirect URI
# {NEXUS_PUBLIC_URL}/api/connectors/oauth/callback
NEXUS_GOOGLE_CLIENT_ID=
NEXUS_GOOGLE_CLIENT_SECRET=
# NEXUS_PUBLIC_URL=http://localhost:3000

# Infrastructure. All optional: unset means SQLite, embedded Qdrant and an in-process cache.
# NEXUS_DATABASE_URL=postgresql+psycopg://nexus:password@localhost:5432/nexus
# NEXUS_QDRANT_URL=http://localhost:6333
# NEXUS_REDIS_URL=redis://localhost:6379/0

# Retrieval
# NEXUS_EMBEDDING_PROVIDER=openai               # openai | local | hashing
# NEXUS_RERANKER_MODEL=BAAI/bge-reranker-v2-m3  # optional cross-encoder
# NEXUS_PRICE_OVERRIDES=my-model=0.5:1.5        # USD per million tokens, input:output
# NEXUS_SYNC_INTERVAL_MINUTES=30
